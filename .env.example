# Supabase — mag hetzelfde project zijn als Nextpedition (tabellen hebben prefix dm_)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key — alleen op de server, nooit delen>

# Facilitatorscherm
ADMIN_PASSWORD=<kies een sterk wachtwoord>
ADMIN_SECRET=<lange willekeurige tekst, minstens 24 tekens>

# Melding per beta-aanmelding (optioneel). Zonder deze twee staat de aanmelding alleen op /admin.
RESEND_API_KEY=<sleutel van resend.com>
MELD_EMAIL=<adres waar de melding heen moet>
# MELD_FROM=Pressure Map <meldingen@jouwdomein.nl>   (alleen nodig met een eigen, geverifieerd domein)
